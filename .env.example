# Copy to .env.local (never commit .env.local) and fill in your values.

# Required for the AI assistant. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_actual_api_key

# Optional: override the model (default is gemini-3.5-flash-lite; see https://ai.google.dev/gemini-api/docs/models)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: sites allowed to call /api/chat from another origin (comma separated).
# Needed when the static site (GitHub Pages) talks to this server (e.g. on Vercel).
# CHAT_ALLOWED_ORIGINS=https://bhavnajay.github.io

# Recommended in production: shared rate limiting across serverless instances (free tier at upstash.com).
# Without these, the limiter falls back to per-instance memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_MAX=12
# RATE_LIMIT_WINDOW_SEC=60

# Only for the static GitHub Pages build: the public URL of the server that hosts /api/chat.
# (Set as a GitHub repository *variable* named CHAT_API_URL, not here.)
# NEXT_PUBLIC_CHAT_API_URL=https://your-project.vercel.app
